<div id="<%= dom_id customer %>" class="w-full sm:w-auto my-5 space-y-5">
  <div>
    <strong class="block font-medium mb-1">Name:</strong>
    <%= customer.name %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Shortname:</strong>
    <%= customer.shortname %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Business ID:</strong>
    <%= customer.business_id %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Active:</strong>
    <%= customer.active? ? "Yes" : "No" %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Has contract:</strong>
    <%= customer.has_contract? ? "Yes" : "No" %>
  </div>
</div>
