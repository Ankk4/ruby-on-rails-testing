<% content_for :title, "#{@overview.customer.name} · Project Control" %>
<% projects = @overview.projects.to_a %>
<% active_count = projects.count(&:active?) %>
<% active_share = projects.empty? ? 0 : (100.0 * active_count / projects.size).round %>

<div class="ledger-control">
  <header class="control-bar">
    <a class="control-brand" href="<%= customers_path %>"><span class="mini-orb" aria-hidden="true"></span><span>LEDGER<small>PROJECT SYSTEMS</small></span></a>
    <span class="control-bar-label">CUSTOMER WORKSPACE / <%= @overview.customer.id.to_s.rjust(4, "0") %></span>
    <span class="control-date"><%= l(Date.current, format: :long) %></span>
  </header>

  <div class="control-body">
    <nav class="control-nav" aria-label="Workspace sections">
      <p class="micro-label">DESTINATIONS</p>
      <a href="#control-overview" class="selected" aria-current="page"><span aria-hidden="true">01</span> Overview</a>
      <a href="#control-projects"><span aria-hidden="true">02</span> Projects <b><%= projects.size %></b></a>
      <a href="#control-customer"><span aria-hidden="true">03</span> Customer details</a>
      <div class="nav-footer"><span class="mini-orb" aria-hidden="true"></span><p>Connected workspace<small>Customer #<%= @overview.customer.id %></small></p></div>
    </nav>

    <div class="control-content" id="control-overview">
      <header class="control-heading">
        <div><p class="micro-label">WORKSPACE / <%= @overview.customer.shortname.presence || @overview.customer.name %></p><h1>Project Control</h1><p><%= @overview.customer.name %> — a clear view of your projects and activity.</p></div>
        <%= link_to "Create Project →", new_customer_project_path(@overview.customer), class: "control-button" %>
      </header>

      <% if notice.present? %><p class="control-notice" role="status"><%= notice %></p><% end %>

      <section class="control-summary" aria-label="Project summary">
        <div class="control-instruments glass-panel">
          <div class="activity-orbit" style="--activity: <%= active_share %>%" role="img" aria-label="<%= active_share %> percent of projects are active"><div><strong><%= active_share %><small>%</small></strong><span>ACTIVE SHARE</span></div></div>
          <div><p class="micro-label">PROJECT SIGNAL</p><h2><%= active_count %> of <%= projects.size %> active</h2><p>Current project availability.<br>Activity status, not completion progress.</p></div>
        </div>
        <div class="control-counters glass-panel">
          <div><span class="micro-label">PROJECTS</span><strong><%= projects.size.to_s.rjust(2, "0") %></strong><small>Total in workspace</small></div>
          <div><span class="micro-label">REPORTED EVENTS</span><strong><%= projects.sum { |project| project.events.size }.to_s.rjust(2, "0") %></strong><small>Across all projects</small></div>
        </div>
      </section>

      <div class="control-columns">
        <section id="control-projects" class="project-station" aria-labelledby="projects-heading">
          <header class="section-heading"><div><p class="micro-label">STATION 01</p><h2 id="projects-heading">Projects</h2></div><span class="technical-label"><%= projects.size %> RECORDS</span></header>
          <% if projects.empty? %>
            <div class="glass-panel control-empty"><span class="mini-orb" aria-hidden="true"></span><h3>Ready for your first project</h3><p>Create a project to connect billing details and reported events.</p><%= link_to "Create Project →", new_customer_project_path(@overview.customer), class: "control-button" %></div>
          <% else %>
            <div class="project-rail">
              <% projects.each do |project| %>
                <article class="control-project glass-panel">
                  <header><div><p class="micro-label">PRJ / <%= project.id.to_s.rjust(4, "0") %></p><h3><%= project.name %></h3></div><span class="control-status <%= project.active? ? 'is-active' : 'is-inactive' %>"><i aria-hidden="true"></i><%= project.active? ? "Active" : "Inactive" %></span></header>
                  <dl class="project-billing"><div><dt>HOURLY RATE</dt><dd><%= project.hourly_rate.nil? ? "Not set" : number_with_precision(project.hourly_rate, precision: 2, delimiter: ",") %></dd></div><div><dt>MONTHLY BUDGET</dt><dd><%= project.monthly_budget.nil? ? "Not set" : number_with_precision(project.monthly_budget, precision: 2, delimiter: ",") %></dd></div></dl>
                  <div class="project-events"><div class="events-heading"><h4>Recent activity</h4><span class="technical-label"><%= project.events.size %> EVENTS</span></div>
                    <% if project.events.empty? %><p class="event-empty">No events reported. Your activity will appear here.</p><% else %>
                      <ol class="event-timeline"><% project.events.sort_by(&:created_at).reverse.first(3).each do |event| %><li><span>Event #<%= event.id %></span><span><%= event.start ? l(event.start, format: :long) : "Start not set" %> — <%= event.end ? l(event.end, format: :long) : "End not set" %></span></li><% end %></ol>
                    <% end %>
                  </div>
                </article>
              <% end %>
            </div>
          <% end %>
        </section>

        <aside id="control-customer" class="glass-panel customer-module" aria-labelledby="customer-heading">
          <p class="micro-label">ACCOUNT / <%= @overview.customer.id.to_s.rjust(4, "0") %></p><h2 id="customer-heading">Customer details</h2>
          <div class="customer-identity"><span class="identity-tile" aria-hidden="true"><%= @overview.customer.name.to_s.first.upcase %></span><strong><%= @overview.customer.name %></strong></div>
          <dl><div><dt>Business ID</dt><dd><%= @overview.customer.business_id.presence || "Not provided" %></dd></div><div><dt>Customer status</dt><dd><span class="control-status <%= @overview.customer.active? ? 'is-active' : 'is-inactive' %>"><i aria-hidden="true"></i><%= @overview.customer.active? ? "Active" : "Inactive" %></span></dd></div><div><dt>Contract</dt><dd><%= @overview.customer.has_contract? ? "On file" : "No contract on file" %></dd></div></dl>
          <p class="module-footnote">Billing figures reflect project settings. They are not invoice totals.</p>
        </aside>
      </div>
      <footer class="control-footer"><span>LEDGER / PROJECT CONTROL</span><span><%= projects.size %> PROJECTS · CUSTOMER #<%= @overview.customer.id %></span></footer>
    </div>
  </div>
</div>
